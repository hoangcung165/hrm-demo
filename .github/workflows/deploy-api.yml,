# Deploy the API to the EC2 instance (docs/ops/deployment.md). Manual only, from main:
# - empty image_tag: build the image of main, push it to GHCR as <sha> and latest, then deploy it;
# - image_tag set (a commit SHA of an earlier run): deploy that image again without building, to roll back.
# The web app is deployed by Vercel, not here.
name: Deploy API

on:
  workflow_dispatch:
    inputs:
      image_tag:
        description: "Image tag to deploy again (a full commit SHA from an earlier run). Empty: build main."
        required: false
        default: ""

concurrency:
  group: deploy-api
  cancel-in-progress: false

permissions:
  contents: read
  packages: write

jobs:
  build:
    name: Build and push the image
    runs-on: ubuntu-latest
    timeout-minutes: 30
    outputs:
      tag: ${{ steps.tag.outputs.tag }}
    steps:
      - name: Only from main
        if: github.ref != 'refs/heads/main'
        run: |
          echo "::error::Deploy runs from main only, not ${GITHUB_REF}."
          exit 1

      - name: Pick the tag
        id: tag
        env:
          IMAGE_TAG: ${{ inputs.image_tag }}
        run: |
          if [ -n "$IMAGE_TAG" ]; then
            if ! printf '%s' "$IMAGE_TAG" | grep -Eq '^[0-9a-f]{40}$'; then
              echo "::error::image_tag must be a full commit SHA."
              exit 1
            fi
            echo "tag=$IMAGE_TAG" >> "$GITHUB_OUTPUT"
          else
            echo "tag=$GITHUB_SHA" >> "$GITHUB_OUTPUT"
          fi
          echo "image=ghcr.io/${GITHUB_REPOSITORY,,}" >> "$GITHUB_ENV"

      - uses: actions/checkout@v4
        if: inputs.image_tag == ''

      - uses: docker/setup-buildx-action@v3
        if: inputs.image_tag == ''

      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - uses: docker/build-push-action@v6
        if: inputs.image_tag == ''
        with:
          context: .
          push: true
          tags: |
            ${{ env.image }}:${{ steps.tag.outputs.tag }}
            ${{ env.image }}:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Check that a rollback tag exists
        if: inputs.image_tag != ''
        run: docker manifest inspect "${image}:${{ steps.tag.outputs.tag }}" > /dev/null

  deploy:
    name: Deploy to EC2
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: production
    env:
      EC2_HOST: ${{ secrets.EC2_HOST }}
      EC2_USER: ${{ secrets.EC2_USER }}
      EC2_SSH_KEY: ${{ secrets.EC2_SSH_KEY }}
      EC2_KNOWN_HOSTS: ${{ secrets.EC2_KNOWN_HOSTS }}
      HRM_API_HOST: ${{ vars.HRM_API_HOST }}
      TAG: ${{ needs.build.outputs.tag }}
    steps:
      - name: Check the settings
        run: |
          missing=""
          for name in EC2_HOST EC2_USER EC2_SSH_KEY EC2_KNOWN_HOSTS HRM_API_HOST; do
            [ -n "${!name}" ] || missing="$missing $name"
          done
          if [ -n "$missing" ]; then
            echo "::error::Not set in the production environment:$missing. See docs/ops/deployment.md."
            exit 1
          fi
          echo "IMAGE=ghcr.io/${GITHUB_REPOSITORY,,}:$TAG" >> "$GITHUB_ENV"

      - uses: actions/checkout@v4

      - name: Set up SSH
        run: |
          install -m 700 -d ~/.ssh
          printf '%s\n' "$EC2_SSH_KEY" > ~/.ssh/id_ec2
          chmod 600 ~/.ssh/id_ec2
          printf '%s\n' "$EC2_KNOWN_HOSTS" > ~/.ssh/known_hosts
          printf 'Host ec2\n  HostName %s\n  User %s\n  IdentityFile ~/.ssh/id_ec2\n  StrictHostKeyChecking yes\n' \
            "$EC2_HOST" "$EC2_USER" > ~/.ssh/config

      - name: Copy the compose files
        run: |
          ssh ec2 'mkdir -p ~/hrm/deploy/ec2 && test -f ~/hrm/.env' \
            || { echo "::error::~/hrm/.env is missing on the instance. See docs/ops/deployment.md."; exit 1; }
          scp docker-compose.prod.yml ec2:hrm/
          scp deploy/ec2/docker-compose.ec2.yml deploy/ec2/Caddyfile ec2:hrm/deploy/ec2/

      - name: Pull and restart
        env:
          GHCR_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          printf '%s' "$GHCR_TOKEN" | ssh ec2 "docker login ghcr.io -u '${{ github.actor }}' --password-stdin"
          # HRM_IMAGE goes into .env, so a manual compose command on the instance runs the same image.
          ssh ec2 "cd ~/hrm && sed -i '/^HRM_IMAGE=/d' .env && echo 'HRM_IMAGE=$IMAGE' >> .env \
            && compose='docker compose -f docker-compose.prod.yml -f deploy/ec2/docker-compose.ec2.yml' \
            && \$compose pull app caddy mail \
            && \$compose up -d --no-build --remove-orphans; status=\$?; \
            docker logout ghcr.io > /dev/null; \
            docker image prune -af --filter until=168h > /dev/null; exit \$status"

      - name: Wait for the health check
        run: |
          url="https://$HRM_API_HOST/actuator/health"
          for i in $(seq 1 36); do
            if curl -fsS --max-time 5 "$url" | grep -q '"status":"UP"'; then
              echo "Up: $url ($IMAGE)"
              exit 0
            fi
            sleep 5
          done
          echo "::error::$url did not report UP within 3 minutes."
          ssh ec2 "cd ~/hrm && docker compose -f docker-compose.prod.yml -f deploy/ec2/docker-compose.ec2.yml logs --tail 80 app" || true
          exit 1
