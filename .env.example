# Copy to .env to override the default dev settings.
HRM_DB_URL=jdbc:postgresql://localhost:5432/hrm
HRM_DB_USER=hrm
HRM_DB_PASSWORD=hrm
# Host port for Postgres in docker compose (change if 5432 is taken; update HRM_DB_URL too)
HRM_DB_PORT=5432

# Auth. Required outside the dev profile (the dev profile has local-only defaults).
# HS256 signing key for access tokens, at least 32 characters.
HRM_JWT_SECRET=change-me-to-a-random-string-of-32+-chars
# First Admin Account, created only while the account table is empty.
HRM_ADMIN_EMAIL=admin@hrm.local
HRM_ADMIN_PASSWORD=change-me
# Refresh cookie Secure flag; set false only when serving over plain HTTP locally.
HRM_COOKIE_SECURE=true
