# Copy to .env to override the default dev settings.
HRM_DB_URL=jdbc:postgresql://localhost:5432/hrm
HRM_DB_USER=hrm
HRM_DB_PASSWORD=hrm
# Host port for Postgres in docker compose (change if 5432 is taken; update HRM_DB_URL too)
HRM_DB_PORT=5432
# Demo database on Supabase (docker-compose.prod.yml), see docs/ops/database.md. Quote the URL, it contains '&'.
# HRM_DB_URL="jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&currentSchema=hrm"
# HRM_DB_USER=hrm_app.<project ref>
# SPRING_FLYWAY_DEFAULT_SCHEMA=hrm
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5

# Auth. Required outside the dev profile (the dev profile has local-only defaults).
# HS256 signing key for access tokens, at least 32 characters.
HRM_JWT_SECRET=change-me-to-a-random-string-of-32+-chars
# First Admin Account, created only while the account table is empty.
HRM_ADMIN_EMAIL=admin@hrm.local
HRM_ADMIN_PASSWORD=change-me
# Name shown for that Account (default "Quản trị viên").
# HRM_ADMIN_FULL_NAME=Quản trị viên
# Refresh cookie Secure flag; set false only when serving over plain HTTP locally.
HRM_COOKIE_SECURE=true
# How long a refresh token may be exchanged again after its first use (fast double reload, two tabs).
HRM_REFRESH_REUSE_GRACE=10s

# Example data: on a database without organization units, create a fictional company and org tree at startup.
# Default: on in the dev profile and in docker-compose.yml, off everywhere else (docker-compose.prod.yml never sets it).
# HRM_EXAMPLE_DATA=true

# Demo personas for the "Demo as…" switch: one seeded Account per role (demo.<role>@hrm.local).
# WARNING: while this is on, any signed-in Account can become Admin. Demo data only, never real data.
# Default: on in the dev profile and in docker-compose.yml, off everywhere else (docker-compose.prod.yml too).
# Turning it off locks the persona Accounts at the next start; turning it on again does not unlock them.
# HRM_DEMO_PERSONAS=true

# Mail (defaults: Mailpit from docker compose) and the web app URL used in email links.
HRM_MAIL_HOST=localhost
HRM_MAIL_PORT=1025
HRM_MAIL_FROM=no-reply@hrm.local
HRM_APP_URL=http://localhost:5173
# With docker compose the app serves the web UI itself: use http://localhost:8080 (the compose default).
# Host port of the app in docker compose.
HRM_APP_PORT=8080

# EC2 demo deployment only (docs/ops/deployment.md): Caddy serves HTTPS for this host name, and the app port
# listens on the loopback interface. The deploy workflow sets HRM_IMAGE.
# HRM_API_HOST=api.example.com
# HRM_APP_PORT=127.0.0.1:8080
